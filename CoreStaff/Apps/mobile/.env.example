# Expo — copy to Apps/mobile/.env
# Primary API (Vercel). Dev probes this first.
EXPO_PUBLIC_API_URL=https://becorestaff.vercel.app
# Fallback when remote healthz fails (__DEV__ only).
# Android emulator: localhost in this value is rewritten to 10.0.2.2
EXPO_PUBLIC_API_FALLBACK_URL=http://localhost:3000
