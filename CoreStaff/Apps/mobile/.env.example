EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_API_FALLBACK_URL=http://localhost:3000
# Expo SDK 57 swaps globalThis.fetch for expo/fetch, which rejects React Native's
# FormData file parts ({ uri, name, type }) with "Unsupported FormDataPart
# implementation". The selfie upload needs the RN fetch (XHR) to work.
EXPO_PUBLIC_USE_RN_FETCH=1