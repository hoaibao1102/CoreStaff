# MongoDB Atlas — connection URI (keep this value secret)
# Copy this file to Apps/api/.env and fill in real values.
MONGODB_URI=paste_your_atlas_connection_string_here

# Platform bootstrap (System Admin creation) — real values only in local .env
PLATFORM_ADMIN_EMAIL=sysadmin@corestaff.local
PLATFORM_ADMIN_PASSWORD=change-me-strong-password

# Temp password for every seeded demo account. Optional in dev (a local demo
# default is used); required in any other NODE_ENV — DoD forbids committed creds.
# SEED_PASSWORD=change-me-strong-password

# App config
# PORT is assigned by the host on Vercel — do not set it there.
PORT=3000
# APP_TZ (not TZ): Vercel reserves the name TZ.
APP_TZ=Asia/Ho_Chi_Minh