# MongoDB Atlas — connection URI (keep this value secret)
# Copy this file to Apps/api/.env and fill in real values.
MONGODB_URI=paste_your_atlas_connection_string_here

# Platform bootstrap (System Admin creation) — real values only in local .env
PLATFORM_ADMIN_EMAIL=sysadmin@corestaff.local
PLATFORM_ADMIN_PASSWORD=change-me-strong-password

# Temp password for every seeded demo account. Optional in dev (a local demo
# default is used); required in any other NODE_ENV — DoD forbids committed creds.
# SEED_PASSWORD=change-me-strong-password

# App config
# PORT is assigned by the host on Vercel — do not set it there.
PORT=3000
# APP_TZ (not TZ): Vercel reserves the name TZ.
APP_TZ=Asia/Ho_Chi_Minh

# Private object storage (TASK-029 employee documents) — S3-compatible.
# Real values only in local .env (same protection as MONGODB_URI / SEED_PASSWORD).
# S3_REGION + S3_BUCKET are required for document upload/download; without them
# uploads fail fast with STORAGE_NOT_CONFIGURED.
S3_REGION=paste_your_aws_region_here
S3_BUCKET=corestaff-private-docs
# Optional: MinIO / LocalStack endpoint override (dev only). Leave unset for AWS.
# S3_ENDPOINT=http://localhost:9000
# Optional: explicit keys. Leave unset on EC2 to use the default credential
# chain / instance IAM role. NEVER commit real keys — .env is git-ignored.
# AWS_ACCESS_KEY_ID=paste_your_aws_access_key_id_here
# AWS_SECRET_ACCESS_KEY=paste_your_aws_secret_access_key_here